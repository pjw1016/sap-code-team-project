<mvc:View
    controllerName="code.d3.purchaseprocessmonitor.controller.Main"
    displayBlock="true"
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f"
    xmlns:mvc="sap.ui.core.mvc">
    <!--
        FlexibleColumnLayout은 이번 앱의 핵심 화면 뼈대다.
        Begin Column은 전체 조달 병목을 보는 모니터링 영역이고,
        Mid Column은 사용자가 PO 행을 선택했을 때 상세 Flow와 품목 상태를 보는 영역이다.

        layout은 view JSONModel에서 관리한다.
        - 최초 진입: OneColumn
        - PO 선택: TwoColumnsMidExpanded
        - Mid 전체화면: MidColumnFullScreen
    -->
    <f:FlexibleColumnLayout
        id="fcl"
        layout="{view>/layout}"
        backgroundDesign="Translucent">
        <f:beginColumnPages>
            <f:DynamicPage
                id="beginPage"
                fitContent="false"
                headerExpanded="true"
                preserveHeaderStateOnScroll="false"
                showFooter="false">
                <f:title>
                    <f:DynamicPageTitle>
                        <f:heading>
                            <Title
                                level="H1"
                                text="조회 조건" />
                        </f:heading>
                    </f:DynamicPageTitle>
                </f:title>

                <f:header>
                    <f:DynamicPageHeader pinnable="true">
                        <!--
                            조회조건은 V1.2.1 기준으로 기본조건과 상세조건을 분리한다.
                            기본조건: 기준일, 조회기간, PR번호, PO번호
                            상세조건: 자재코드, 자재명, 공급업체, 공급업체명, 플랜트

                            각 Control은 filter JSONModel에 바인딩한다.
                            이렇게 하면 Controller에서 Control ID를 찾아 값을 읽지 않고,
                            filter 모델 값만 기준으로 OData Filter를 만들 수 있다.
                        -->
                        <VBox class="sapUiSmallMargin" renderType="Bare">
                            <VBox renderType="Bare">
                                <!-- <Title
                                    level="H4"
                                    text="기본 조회조건"
                                    class="sapUiTinyMarginBottom" /> -->

                                <!--
                                    기본 조회조건은 자주 쓰는 조건이므로 한 줄 검색바처럼 배치한다.
                                    각 필드 폭을 고정해 Input이 과도하게 늘어나지 않게 하고,
                                    화면 폭이 좁아지면 wrap="Wrap"에 의해 다음 줄로 자연스럽게 내려가게 한다.
                                -->
                                <HBox
                                    id="basicFilterBar"
                                    wrap="Wrap"
                                    renderType="Bare">
                                    <VBox
                                        width="11rem"
                                        class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                                        <Label
                                            text="기준일"
                                            labelFor="keyDatePicker"
                                            required="true" />
                                        <DatePicker
                                            id="keyDatePicker"
                                            dateValue="{filter>/KeyDate}"
                                            displayFormat="yyyy.MM.dd"
                                            valueFormat="yyyy-MM-dd"
                                            width="100%" />
                                    </VBox>

                                    <VBox
                                        width="16rem"
                                        class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                                        <Label
                                            text="조회기간"
                                            labelFor="lookbackSegmentedButton" />
                                        <SegmentedButton
                                            id="lookbackSegmentedButton"
                                            selectedKey="{filter>/LookbackMonths}"
                                            width="100%">
                                            <items>
                                                <SegmentedButtonItem
                                                    key="3"
                                                    text="최근 3개월" />
                                                <SegmentedButtonItem
                                                    key="6"
                                                    text="최근 6개월" />
                                            </items>
                                        </SegmentedButton>
                                    </VBox>

                                    <VBox
                                        width="18rem"
                                        class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                                        <Label
                                            text="지연 상태"
                                            labelFor="delayStatusCombo" />
                                        <!--
                                            지연 상태는 여러 상태를 동시에 조회할 수 있어야 하므로
                                            SAPUI5 표준 sap.m.MultiComboBox를 사용한다.

                                            selectedKeys는 filter>/DelayStatuses 배열과 양방향 바인딩된다.
                                            기본값은 KPI 요약 카드 명칭과 같은 지연/미완료 상태이며,
                                            정상(NORMAL)은 PR/PO 정상 건이 대량 조회될 수 있어 사용자가 직접 선택할 때만 포함한다.
                                        -->
                                        <MultiComboBox
                                            id="delayStatusCombo"
                                            selectedKeys="{filter>/DelayStatuses}"
                                            width="100%"
                                            placeholder="지연 상태 선택"
                                            selectionFinish=".onDelayStatusSelectionFinish">
                                            <core:Item key="PR_DELAY" text="PR 처리 지연" />
                                            <core:Item key="RFQ_NO_QUOTATION" text="RFQ 미접수" />
                                            <core:Item key="MQ_SELECTION_DELAY" text="MQ 채택 지연" />
                                            <core:Item key="PO_DELIVERY_DELAY" text="PO 납기 지연" />
                                            <core:Item key="IV_INCOMPLETE" text="입고 후 미송장" />
                                            <core:Item key="NORMAL" text="정상" />
                                        </MultiComboBox>
                                    </VBox>

                                    <VBox
                                        width="10rem"
                                        class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                                        <Label
                                            text="문서유형"
                                            labelFor="docTypeSelect" />
                                        <!--
                                            문서유형은 조달 문서 목록의 Header 기준 문서 종류를 좁히는 기본 조회조건이다.
                                            전체(ALL)는 DocType 필터를 보내지 않고, PR/RFQ/PO 선택 시 DelayListSet에
                                            DocType 단독 필터를 전달한다. 사용자가 PO만 조회한 뒤 Mid Column 상세로
                                            진입하기 쉽게 하기 위한 보조 필터다.
                                        -->
                                        <Select
                                            id="docTypeSelect"
                                            selectedKey="{filter>/DocType}"
                                            width="100%">
                                            <core:Item key="ALL" text="전체" />
                                            <core:Item key="PR" text="PR(구매요청)" />
                                            <core:Item key="RFQ" text="RFQ(견적요청)" />
                                            <core:Item key="PO" text="PO(구매오더)" />
                                        </Select>
                                    </VBox>
                                </HBox>
                            </VBox>

                            <VBox
                                id="advancedFilterBox"
                                visible="{view>/showAdvancedFilters}"
                                renderType="Bare">
                                <Title
                                    text="상세조건"
                                    class="sapUiSmallMarginTop sapUiTinyMarginBottom" />

                                <!--
                                    상세 조회조건도 가능한 한 한 줄에 표시한다.
                                    단, 작은 노트북/브라우저 축소 상태에서는 가로 스크롤 대신 자동 줄바꿈으로 접근성을 유지한다.
                                -->
                                <HBox
                                    id="advancedFilterBar"
                                    wrap="Wrap"
                                    renderType="Bare">
                                    <VBox
                                        width="12rem"
                                        class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                                        <Label
                                            text="자재코드"
                                            labelFor="matnrInput" />
                                        <Input
                                            id="matnrInput"
                                            value="{filter>/Matnr}"
                                            maxLength="10"
                                            placeholder="자재코드 입력"
                                            showValueHelp="true"
                                            width="100%" />
                                    </VBox>

                                    <VBox
                                        width="14rem"
                                        class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                                        <Label
                                            text="자재명"
                                            labelFor="matnrNameInput" />
                                        <Input
                                            id="matnrNameInput"
                                            value="{filter>/Maktx}"
                                            maxLength="40"
                                            placeholder="자재명 입력"
                                            width="100%" />
                                    </VBox>

                                    <VBox
                                        width="12rem"
                                        class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                                        <Label
                                            text="공급업체"
                                            labelFor="lifnrInput" />
                                        <Input
                                            id="lifnrInput"
                                            value="{filter>/Lifnr}"
                                            maxLength="6"
                                            placeholder="공급업체코드 입력"
                                            showValueHelp="true"
                                            width="100%" />
                                    </VBox>

                                    <VBox
                                        width="14rem"
                                        class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                                        <Label
                                            text="공급업체명"
                                            labelFor="lifnrNameInput" />
                                        <Input
                                            id="lifnrNameInput"
                                            value="{filter>/Name1}"
                                            maxLength="40"
                                            placeholder="공급업체명 입력"
                                            width="100%" />
                                    </VBox>

                                    <VBox
                                        width="10rem"
                                        class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                                        <Label
                                            text="플랜트"
                                            labelFor="werksInput" />
                                        <Input
                                            id="werksInput"
                                            value="{filter>/Werks}"
                                            maxLength="6"
                                            placeholder="플랜트 입력"
                                            showValueHelp="true"
                                            width="100%" />
                                    </VBox>

                                    <VBox
                                        width="10.5rem"
                                        class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                                        <Label
                                            text="PR번호"
                                            labelFor="prNoInput" />
                                        <Input
                                            id="prNoInput"
                                            value="{filter>/PrNo}"
                                            maxLength="10"
                                            placeholder="PR번호 입력"
                                            width="100%" />
                                    </VBox>

                                    <VBox
                                        width="10.5rem"
                                        class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                                        <Label
                                            text="RFQ번호"
                                            labelFor="rfqNoInput" />
                                        <Input
                                            id="rfqNoInput"
                                            value="{filter>/RfqNo}"
                                            maxLength="10"
                                            placeholder="RFQ번호 입력"
                                            width="100%" />
                                    </VBox>

                                    <VBox
                                        width="10.5rem"
                                        class="sapUiSmallMarginEnd sapUiTinyMarginBottom">
                                        <Label
                                            text="PO번호"
                                            labelFor="poNoInput" />
                                        <Input
                                            id="poNoInput"
                                            value="{filter>/PoNo}"
                                            maxLength="10"
                                            placeholder="PO번호 입력"
                                            width="100%" />
                                    </VBox>
                                </HBox>
                            </VBox>

                            <OverflowToolbar class="sapUiTinyMarginTop">
                                <ToolbarSpacer />
                                <Button
                                    id="toggleAdvancedFilterButton"
                                    text="{= ${view>/showAdvancedFilters} ? '상세조건 접기' : '상세조건' }"
                                    type="Transparent"
                                    press=".onToggleAdvancedFilters" />
                                <Button
                                    id="resetFilterButton"
                                    text="초기화"
                                    type="Transparent"
                                    press=".onResetFilters" />
                                <Button
                                    id="searchButton"
                                    text="조회"
                                    type="Emphasized"
                                    press=".onSearch" />
                            </OverflowToolbar>
                        </VBox>
                    </f:DynamicPageHeader>
                </f:header>

                <f:content>
                    <VBox class="sapUiSmallMargin" renderType="Bare">
                        <!--
                            Begin Column의 실제 데이터 바인딩은 이후 단계에서 순차 구현한다.
                            지금은 화면 구조가 흔들리지 않도록 섹션의 위치와 ID를 먼저 확정한다.
                        -->
                        <FlexBox
                            wrap="Wrap"
                            renderType="Bare"
                            class="sapUiSmallMarginBottom ppmSummaryRow">
                            <VBox
                                width="64%"
                                class="sapUiSmallMarginEnd ppmKpiSummaryColumn">
                                <Panel
                                    id="kpiSection"
                                    class="sapUiNoContentPadding">
                                    <headerToolbar>
                                        <OverflowToolbar>
                                            <Title
                                                text="KPI 요약"
                                                level="H2" />
                                            <ToolbarSpacer />
                                            <Button
                                                id="clearKpiFilterButton"
                                                icon="sap-icon://clear-filter"
                                                type="Transparent"
                                                tooltip="KPI 필터 해제"
                                                press=".onClearKpiFilter" />
                                        </OverflowToolbar>
                                    </headerToolbar>
                                    <!--
                                        DashboardSummarySet KPI 카드.
                                        - 큰 숫자: Header 기준 문서 수
                                        - 보조 문구: Item 기준 품목 수
                                        실제 OData 조회 전에는 dashboard JSONModel의 기본값 0이 표시된다.
                                    -->
                                    <FlexBox
                                        wrap="Wrap"
                                        renderType="Bare"
                                        class="sapUiSmallMargin">
                                        <GenericTile
                                            header="PR 처리 지연"
                                            subheader="{= '품목 ' + ${dashboard>/PrDlyItmCnt} + '건 / 후속 확장' }"
                                            press=".onKpiDelayStatusPress"
                                            frameType="OneByOne"
                                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <customData>
                                                <core:CustomData key="delayStatus" value="PR_DELAY" />
                                            </customData>
                                            <tileContent>
                                                <TileContent>
                                                    <content>
                                                        <NumericContent
                                                            icon="sap-icon://activity-items"
                                                            value="{path: 'dashboard>/PrDlyHdrCnt', formatter: '.formatter.formatQuantity'}"
                                                            scale="건"
                                                            valueColor="Neutral"
                                                            truncateValueTo="5" />
                                                    </content>
                                                </TileContent>
                                            </tileContent>
                                        </GenericTile>

                                        <GenericTile
                                            header="RFQ 미접수"
                                            subheader="{= '품목 ' + ${dashboard>/RfqNoqItmCnt} + '건' }"
                                            press=".onKpiDelayStatusPress"
                                            frameType="OneByOne"
                                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <customData>
                                                <core:CustomData key="delayStatus" value="RFQ_NO_QUOTATION" />
                                            </customData>
                                            <tileContent>
                                                <TileContent>
                                                    <content>
                                                        <NumericContent
                                                            icon="sap-icon://request"
                                                            value="{path: 'dashboard>/RfqNoqHdrCnt', formatter: '.formatter.formatQuantity'}"
                                                            scale="건"
                                                            valueColor="Error"
                                                            truncateValueTo="5" />
                                                    </content>
                                                </TileContent>
                                            </tileContent>
                                        </GenericTile>

                                        <GenericTile
                                            header="MQ 채택 지연"
                                            subheader="{= '품목 ' + ${dashboard>/MqSelDlyItmCnt} + '건' }"
                                            press=".onKpiDelayStatusPress"
                                            frameType="OneByOne"
                                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <customData>
                                                <core:CustomData key="delayStatus" value="MQ_SELECTION_DELAY" />
                                            </customData>
                                            <tileContent>
                                                <TileContent>
                                                    <content>
                                                        <NumericContent
                                                            icon="sap-icon://target-group"
                                                            value="{path: 'dashboard>/MqSelDlyHdrCnt', formatter: '.formatter.formatQuantity'}"
                                                            scale="건"
                                                            valueColor="Critical"
                                                            truncateValueTo="5" />
                                                    </content>
                                                </TileContent>
                                            </tileContent>
                                        </GenericTile>

                                        <GenericTile
                                            header="PO 납기 지연"
                                            subheader="{= '품목 ' + ${dashboard>/PoDlvDlyItmCnt} + '건' }"
                                            press=".onKpiDelayStatusPress"
                                            frameType="OneByOne"
                                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <customData>
                                                <core:CustomData key="delayStatus" value="PO_DELIVERY_DELAY" />
                                            </customData>
                                            <tileContent>
                                                <TileContent>
                                                    <content>
                                                        <NumericContent
                                                            icon="sap-icon://shipping-status"
                                                            value="{path: 'dashboard>/PoDlvDlyHdrCnt', formatter: '.formatter.formatQuantity'}"
                                                            scale="건"
                                                            valueColor="Critical"
                                                            truncateValueTo="5" />
                                                    </content>
                                                </TileContent>
                                            </tileContent>
                                        </GenericTile>

                                        <GenericTile
                                            header="입고 후 미송장"
                                            subheader="{= '품목 ' + ${dashboard>/IvIncItmCnt} + '건' }"
                                            press=".onKpiDelayStatusPress"
                                            frameType="OneByOne"
                                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <customData>
                                                <core:CustomData key="delayStatus" value="IV_INCOMPLETE" />
                                            </customData>
                                            <tileContent>
                                                <TileContent>
                                                    <content>
                                                        <NumericContent
                                                            icon="sap-icon://document"
                                                            value="{path: 'dashboard>/IvIncHdrCnt', formatter: '.formatter.formatQuantity'}"
                                                            scale="건"
                                                            valueColor="Error"
                                                            truncateValueTo="5" />
                                                    </content>
                                                </TileContent>
                                            </tileContent>
                                        </GenericTile>

                                        <GenericTile
                                            header="정상"
                                            subheader="{= '품목 ' + ${dashboard>/NormalItmCnt} + '건' }"
                                            press=".onKpiDelayStatusPress"
                                            frameType="OneByOne"
                                            class="sapUiTinyMarginEnd sapUiTinyMarginBottom">
                                            <customData>
                                                <core:CustomData key="delayStatus" value="NORMAL" />
                                            </customData>
                                            <tileContent>
                                                <TileContent>
                                                    <content>
                                                        <NumericContent
                                                            icon="sap-icon://sys-enter-2"
                                                            value="{path: 'dashboard>/NormalHdrCnt', formatter: '.formatter.formatQuantity'}"
                                                            scale="건"
                                                            valueColor="Good"
                                                            truncateValueTo="5" />
                                                    </content>
                                                </TileContent>
                                            </tileContent>
                                        </GenericTile>
                                    </FlexBox>
                                </Panel>
                            </VBox>

                            <VBox
                                width="34%"
                                class="ppmWeeklySummaryColumn">
                                <Panel
                                    id="weeklySummarySection"
                                    class="sapUiNoContentPadding ppmWeeklySummaryPanel"
                                    headerText="주간 구매/입고/송장 요약">
                                    <!--
                                        WeeklySummarySet 주간 요약.
                                        금액 3개는 ObjectNumber로 통화와 함께 표시하고,
                                        건수 2개는 ObjectStatus로 빠르게 상태를 읽을 수 있게 한다.
                                    -->
                                    <FlexBox
                                        wrap="Wrap"
                                        renderType="Bare"
                                        class="sapUiSmallMargin">
                                        <VBox
                                            width="12rem"
                                            class="sapUiSmallMarginEnd sapUiSmallMarginBottom ppmWeeklySummaryItem">
                                            <Label text="구매금액 합계" />
                                            <ObjectNumber
                                                emphasized="true"
                                                number="{path: 'weekly>/PurchaseAmt', formatter: '.formatter.formatAmount'}"
                                                unit="{weekly>/Waers}" />
                                        </VBox>

                                        <VBox
                                            width="12rem"
                                            class="sapUiSmallMarginEnd sapUiSmallMarginBottom ppmWeeklySummaryItem">
                                            <Label text="입고금액 합계" />
                                            <ObjectNumber
                                                emphasized="true"
                                                number="{path: 'weekly>/ReceiptAmt', formatter: '.formatter.formatAmount'}"
                                                unit="{weekly>/Waers}" />
                                        </VBox>

                                        <VBox
                                            width="12rem"
                                            class="sapUiSmallMarginEnd sapUiSmallMarginBottom ppmWeeklySummaryItem">
                                            <Label text="송장금액 합계" />
                                            <ObjectNumber
                                                emphasized="true"
                                                number="{path: 'weekly>/InvoiceAmt', formatter: '.formatter.formatAmount'}"
                                                unit="{weekly>/Waers}" />
                                        </VBox>

                                        <VBox
                                            width="12rem"
                                            class="sapUiSmallMarginEnd sapUiSmallMarginBottom ppmWeeklySummaryItem">
                                            <Label text="금주 입고 완료" />
                                            <ObjectStatus
                                                text="{= ${weekly>/CompGrHdrCnt} + '건' }"
                                                state="Success"
                                                icon="sap-icon://sys-enter-2" />
                                        </VBox>

                                        <VBox
                                            width="12rem"
                                            class="sapUiSmallMarginEnd sapUiSmallMarginBottom ppmWeeklySummaryItem">
                                            <Label text="금주 입고 후 미송장" />
                                            <ObjectStatus
                                                text="{= ${weekly>/IvIncHdrCnt} + '건' }"
                                                state="Error"
                                                icon="sap-icon://alert" />
                                        </VBox>
                                    </FlexBox>
                                </Panel>
                            </VBox>
                        </FlexBox>

                        <FlexBox
                            wrap="Wrap"
                            renderType="Bare">
                            <VBox width="100%">
                                <Panel
                                    id="delayListSection"
                                    class="sapUiNoContentPadding">
                                    <headerToolbar>
                                        <OverflowToolbar>
                                            <Title
                                                text="{= '조달 문서 목록 (' + ${delay>/count} + ')' }"
                                                level="H2" />
                                            <ToolbarSpacer />
                                            <Text text="{view>/DelayTableStatusSummary}" />
                                            <Text text="{view>/DelayTableSortGroupSummary}" />
                                            <Button
                                                icon="sap-icon://sort"
                                                type="Transparent"
                                                tooltip="정렬/그룹 설정"
                                                press=".onOpenDelayTableSettings" />
                                            <Button
                                                icon="sap-icon://reset"
                                                type="Transparent"
                                                tooltip="정렬/그룹 초기화"
                                                press=".onResetDelayTableSettings" />
                                            <Button
                                                icon="sap-icon://refresh"
                                                type="Transparent"
                                                tooltip="새로고침"
                                                press=".onSearch" />
                                        </OverflowToolbar>
                                    </headerToolbar>
                                    <!--
                                        DelayListSet Header 목록.
                                        사용자가 행을 선택하면 다음 단계에서 Mid Column의 ProcessFlowSet/ProcessItemSet 조회로 연결한다.
                                        지금 단계에서는 목록 조회와 표시를 먼저 안정화한다.
                                    -->
                                    <Table
                                        id="delayListTable"
                                        items="{delay>/rows}"
                                        growing="true"
                                        growingThreshold="10"
                                        noDataText="조회된 조달 문서가 없습니다.">
                                        <columns>
                                            <Column
                                                width="7rem"
                                                minScreenWidth="30rem"
                                                demandPopin="true"
                                                popinDisplay="Inline">
                                                <Text text="지연상태" />
                                            </Column>
                                            <Column
                                                width="12rem"
                                                minScreenWidth="40rem"
                                                demandPopin="true"
                                                popinDisplay="Inline">
                                                <Text text="기준문서" />
                                            </Column>
                                            <Column
                                                width="10rem"
                                                minScreenWidth="50rem"
                                                demandPopin="true"
                                                popinDisplay="Inline">
                                                <Text text="자재요약" />
                                            </Column>
                                            <Column
                                                width="10rem"
                                                minScreenWidth="60rem"
                                                demandPopin="true"
                                                popinDisplay="Inline">
                                                <Text text="공급업체" />
                                            </Column>
                                            <Column
                                                width="7rem"
                                                minScreenWidth="70rem"
                                                demandPopin="true"
                                                popinDisplay="Inline">
                                                <Text text="플랜트" />
                                            </Column>
                                            <Column
                                                width="5rem"
                                                hAlign="End"
                                                minScreenWidth="80rem"
                                                demandPopin="true"
                                                popinDisplay="Inline">
                                                <Text text="지연일" />
                                            </Column>
                                            <Column
                                                width="5rem"
                                                hAlign="End"
                                                minScreenWidth="80rem"
                                                demandPopin="true"
                                                popinDisplay="Inline">
                                                <Text text="지연품목" />
                                            </Column>
                                        </columns>
                                        <items>
                                            <ColumnListItem
                                                type="Navigation"
                                                press=".onDelayListItemPress">
                                                <cells>
                                                    <ObjectStatus
                                                        text="{delay>DelayStatusText}"
                                                        state="{path: 'delay>Criticality', formatter: '.formatter.criticalityToValueState'}" />
                                                    <VBox renderType="Bare">
                                                        <ObjectIdentifier
                                                            title="{delay>DocNo}"
                                                            text="{delay>DocType}" />
                                                        <!--
                                                            비고는 문서 자체에 대한 설명이므로 별도 컬럼보다 기준문서 아래 보조 텍스트로 둔다.
                                                            예: "입고 완료 후 송장검증 미완료", "MQ 접수 후 허용일 내 채택 미완료"
                                                        -->
                                                        <Text
                                                            text="{delay>Remark}"
                                                            wrapping="false"
                                                            class="ppmDocMetaText sapUiTinyMarginTop" />
                                                    </VBox>
                                                    <ObjectIdentifier
                                                        title="{path: 'delay>MaterialSummary', formatter: '.formatter.summaryCode'}"
                                                        text="{path: 'delay>MaterialSummary', formatter: '.formatter.summaryText'}" />
                                                    <ObjectIdentifier
                                                        title="{path: 'delay>VendorSummary', formatter: '.formatter.summaryCode'}"
                                                        text="{path: 'delay>VendorSummary', formatter: '.formatter.summaryText'}" />
                                                    <ObjectIdentifier
                                                        title="{path: 'delay>PlantSummary', formatter: '.formatter.summaryCode'}"
                                                        text="{path: 'delay>PlantSummary', formatter: '.formatter.summaryText'}" />
                                                    <ObjectNumber
                                                        number="{path: 'delay>DelayDays', formatter: '.formatter.formatDelayDays'}"
                                                        emphasized="true" />
                                                    <ObjectNumber
                                                        number="{= ${delay>DelayedItemCount} + ' / ' + ${delay>TotalItemCount} }"
                                                        unit="건" />
                                                </cells>
                                            </ColumnListItem>
                                        </items>
                                    </Table>
                                </Panel>
                            </VBox>
                        </FlexBox>
                    </VBox>
                </f:content>
            </f:DynamicPage>
        </f:beginColumnPages>

        <f:midColumnPages>
            <f:DynamicPage
                id="midPage"
                fitContent="false"
                preserveHeaderStateOnScroll="true"
                showFooter="true">
                <f:title>
                    <f:DynamicPageTitle>
                        <f:heading>
                            <Title
                                level="H2"
                                text="PO 조달 흐름 상세" />
                        </f:heading>
                        <f:actions>
                            <!--
                                Mid Column 제어 버튼.
                                PO 행을 선택한 경우에만 표시하고, FCL layout 값에 따라 전체화면/전체화면 해제 버튼을 교대로 보여준다.
                                닫기 버튼은 선택 PO 컨텍스트를 정리하고 Begin Column만 남기는 역할을 한다.
                            -->
                            <OverflowToolbarButton
                                type="Transparent"
                                icon="sap-icon://full-screen"
                                tooltip="전체화면"
                                press=".onEnterMidFullScreen"
                                visible="{= ${view>/selectedDocType} === 'PO' &amp;&amp; ${view>/layout} !== 'MidColumnFullScreen' }" />
                            <OverflowToolbarButton
                                type="Transparent"
                                icon="sap-icon://exit-full-screen"
                                tooltip="전체화면 해제"
                                press=".onExitMidFullScreen"
                                visible="{= ${view>/selectedDocType} === 'PO' &amp;&amp; ${view>/layout} === 'MidColumnFullScreen' }" />
                            <OverflowToolbarButton
                                type="Transparent"
                                icon="sap-icon://decline"
                                tooltip="닫기"
                                press=".onCloseMidColumn"
                                visible="{= ${view>/selectedDocType} === 'PO' }" />
                        </f:actions>
                    </f:DynamicPageTitle>
                </f:title>

                <f:content>
                    <VBox class="sapUiSmallMargin" renderType="Bare">
                        <Panel
                            id="processFlowSection"
                            class="sapUiNoContentPadding sapUiSmallMarginBottom"
                            headerText="조달 문서 흐름">
                            <VBox class="sapUiSmallMargin">
                                <Text text="ProcessFlowSet 기반 PR → RFQ → MQ → PO → GR → IV 카드 영역" />
                            </VBox>
                        </Panel>

                        <Panel
                            id="processItemSection"
                            class="sapUiNoContentPadding"
                            headerText="품목별 진행 상태">
                            <VBox class="sapUiSmallMargin">
                                <Text text="ProcessItemSet 기반 품목별 진행 상태 Table 영역" />
                            </VBox>
                        </Panel>
                    </VBox>
                </f:content>

                <f:footer>
                    <OverflowToolbar>
                        <ToolbarSpacer />
                        <Button
                            text="지연 산식 보기"
                            type="Transparent"
                            enabled="false" />
                        <Button
                            text="문서 상세 보기"
                            type="Emphasized"
                            enabled="false" />
                        <Button
                            text="납기/미입고 앱 이동"
                            type="Transparent"
                            enabled="false" />
                    </OverflowToolbar>
                </f:footer>
            </f:DynamicPage>
        </f:midColumnPages>
    </f:FlexibleColumnLayout>
</mvc:View>
