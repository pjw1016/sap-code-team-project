<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <!--
        SAPUI5 SDK 1.120의 ResponsivePopover를 사용한다.
        데스크톱/태블릿에서는 Footer 버튼 옆 Popover, 휴대폰에서는 전체 화면 Dialog로 동작한다.

        이 화면은 Backend가 반환한 지연 판정 결과를 설명하기 위한 것이다.
        대한민국 공휴일과 Working Day를 Frontend에서 다시 계산하지 않는다.
    -->
    <ResponsivePopover
        id="delayFormulaPopover"
        title="지연 산식"
        contentWidth="26rem"
        placement="Auto"
        showCloseButton="true"
        verticalScrolling="true">
        <content>
            <VBox class="sapUiSmallMargin">
                <ObjectIdentifier
                    title="{detail>/poSummary/DocNo}"
                    text="선택 PO" />

                <ObjectStatus
                    class="sapUiTinyMarginTop sapUiSmallMarginBottom"
                    text="{detail>/poSummary/DelayStatusText}"
                    state="{path: 'detail>/poSummary/Criticality', formatter: '.formatter.criticalityToValueState'}" />

                <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                    <Label text="조회 기준일" />
                    <Text
                        text="{path: 'filter>/KeyDate', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'yyyy.MM.dd'}}" />
                </HBox>

                <HBox justifyContent="SpaceBetween" class="sapUiTinyMarginBottom">
                    <Label text="산정 기준일" />
                    <Text
                        text="{path: 'detail>/poSummary/BaseDate', type: 'sap.ui.model.type.Date', formatOptions: {pattern: 'yyyy.MM.dd'}}" />
                </HBox>

                <HBox justifyContent="SpaceBetween" class="sapUiSmallMarginBottom">
                    <Label text="지연 근무일" />
                    <ObjectNumber
                        number="{path: 'detail>/poSummary/DelayDays', formatter: '.formatter.formatDelayDays'}"
                        state="{path: 'detail>/poSummary/Criticality', formatter: '.formatter.criticalityToValueState'}" />
                </HBox>

                <MessageStrip
                    text="지연일은 토요일, 일요일, 공휴일과 상태별 처리 허용기간을 제외한 근무일 기준입니다."
                    type="Information"
                    showIcon="true"
                    showCloseButton="false"
                    class="sapUiSmallMarginBottom" />

                <Title text="계산 원칙" level="H5" class="sapUiTinyMarginBottom" />
                <Text
                    text="산정 기준일부터 조회 기준일까지의 단순한 날짜 차이가 아닙니다. 업무 상태별 처리 허용기간이 지난 다음 근무일부터 지연일을 산정합니다."
                    wrapping="true" />
                <Text
                    text="화면에는 회사의 근무일 달력과 업무 기준에 따라 계산된 지연일을 표시합니다."
                    wrapping="true"
                    class="sapUiTinyMarginTop" />
            </VBox>
        </content>
        <endButton>
            <Button
                text="닫기"
                press=".onCloseDelayFormulaPopover" />
        </endButton>
    </ResponsivePopover>
</core:FragmentDefinition>
